{
  "name": "baseline",
  "seeds": [
    0,
    1,
    2
  ],
  "data": {
    "processed_dir": "data/processed"
  },
  "model": {
    "type": "feature_baseline",
    "use_geometry": true,
    "centre_fraction": 0.5,
    "learning_rate": 0.1,
    "epochs": 2000,
    "l2": 0.001,
    "balance_classes": true
  },
  "evaluation": {
    "target_coverage": 0.9,
    "size_bins": [
      0,
      12,
      16,
      20,
      1000
    ],
    "robustness": {
      "blur": [
        1.0,
        2.0,
        3.0
      ],
      "resolution": [
        2,
        4,
        8
      ],
      "contrast": [
        0.25,
        0.5,
        0.75
      ]
    }
  }
}