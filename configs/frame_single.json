{
  "name": "frame_single",
  "seeds": [0, 1, 2],
  "data": {"processed_dir": "data/processed"},
  "model": {
    "type": "frame_cnn",
    "clip_rule": "middle",
    "pretrained": true,
    "input_size": 112,
    "dropout": 0.3,
    "epochs": 15,
    "batch_size": 128,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "patience": 4,
    "brightness": 0.1,
    "contrast": 0.2,
    "num_workers": 2,
    "device": "auto"
  },
  "evaluation": {
    "target_coverage": 0.9,
    "size_bins": [0, 12, 16, 20, 1000],
    "robustness": {"blur": [1.0, 2.0, 3.0], "resolution": [2, 4, 8], "contrast": [0.25, 0.5, 0.75]}
  }
}
