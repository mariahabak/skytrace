{
  "name": "resnet18_distance",
  "seeds": [
    0,
    1,
    2
  ],
  "data_config": "configs/data.json",
  "model": {
    "type": "network",
    "pretrained": true,
    "dropout": 0.3,
    "epochs": 12,
    "batch_size": 128,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "patience": 4,
    "num_workers": 2,
    "device": "auto",
    "network": "resnet18",
    "distance_augment": {
      "p": 0.5,
      "min_size": 12,
      "max_size": 64,
      "blur_sigma_max": 1.0,
      "noise_std_max": 0.04
    }
  }
}
